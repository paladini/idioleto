{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idioleto.dev/schemas/idiolect.schema.json",
  "title": "idioleto Idiolect Profile",
  "description": "A local-first authorial style profile containing quantitative stylometrics and semantic anchors.",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "created_at",
    "language",
    "source_summary",
    "stylometrics",
    "semantic_anchors"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier for this idiolect profile."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "description": "Primary BCP 47 language tag inferred or provided for the corpus.",
      "examples": ["en", "pt-BR"]
    },
    "source_summary": {
      "type": "object",
      "required": [
        "file_count",
        "total_characters",
        "total_words",
        "included_extensions"
      ],
      "additionalProperties": false,
      "properties": {
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_characters": {
          "type": "integer",
          "minimum": 0
        },
        "total_words": {
          "type": "integer",
          "minimum": 0
        },
        "included_extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [".md", ".txt", ".pdf"]
          },
          "uniqueItems": true
        }
      }
    },
    "stylometrics": {
      "type": "object",
      "required": [
        "average_sentence_length",
        "type_token_ratio",
        "punctuation_density",
        "passive_voice_ratio",
        "disallowed_ngrams"
      ],
      "additionalProperties": false,
      "properties": {
        "average_sentence_length": {
          "type": "number",
          "minimum": 0,
          "description": "Average number of words per sentence."
        },
        "type_token_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Lexical diversity measured as unique tokens divided by total tokens."
        },
        "punctuation_density": {
          "type": "number",
          "minimum": 0,
          "description": "Punctuation marks per 100 words."
        },
        "passive_voice_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Estimated ratio of passive constructions to total sentences."
        },
        "disallowed_ngrams": {
          "type": "array",
          "description": "N-grams that should be avoided during generation because they are boilerplate, future intent, or non-authorial artifacts.",
          "items": {
            "type": "object",
            "required": ["ngram", "n", "reason"],
            "additionalProperties": false,
            "properties": {
              "ngram": {
                "type": "string",
                "minLength": 1
              },
              "n": {
                "type": "integer",
                "minimum": 1
              },
              "reason": {
                "type": "string",
                "enum": [
                  "future_intent",
                  "boilerplate",
                  "metadata",
                  "citation_artifact",
                  "low_signal"
                ]
              }
            }
          }
        }
      }
    },
    "semantic_anchors": {
      "type": "array",
      "description": "Short, high-signal excerpts and optional embeddings representing philosophy, memories, worldview, and recurring epistemic stance.",
      "items": {
        "type": "object",
        "required": ["id", "kind", "snippet"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "philosophy",
              "memory",
              "worldview",
              "preference",
              "argument_pattern",
              "self_description"
            ]
          },
          "snippet": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "embedding": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Optional vector embedding for local semantic retrieval."
          },
          "embedding_model": {
            "type": "string",
            "description": "Name of the embedding model used, if embedding is present."
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string"
              },
              "location": {
                "type": "string"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["embedding"]
            },
            "then": {
              "required": ["embedding_model"]
            }
          }
        ]
      }
    }
  }
}
